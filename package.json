{
  "name": "capek",
  "version": "1.0.0",
  "private": true,
  "description": "Composable agent runtime and tool contracts for Bun",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test packages/capek packages/capek-tool packages/capek-types",
    "test:core": "bun test packages/capek",
    "test:tool": "bun test packages/capek-tool",
    "test:types": "bun test packages/capek-types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.56.1"
  }
}
